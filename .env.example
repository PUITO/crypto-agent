# ===== 环境 =====
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_REMOTE_ENABLED=true

# ===== LLM (Agent) =====
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:14b
