# ===== 环境 =====
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_REMOTE_ENABLED=true

# ===== LLM (Agent) =====
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:14b
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===== Hugging Face (Data，可选) =====
# HF_TOKEN=
# HF_REPO_ID=your-user/crypto-btc-5m

# ===== 服务发现（可选覆盖） =====
# DATA_SERVICE_URL=http://localhost:8001
# CONFIG_SERVICE_URL=http://localhost:8002
# LOG_SERVICE_URL=http://localhost:8009

# ===== 生产 =====
# ENVIRONMENT=production
# DEBUG=false
# UVICORN_WORKERS=2

# ===== GitHub 持久化同步 (Sync Service) =====
# GITHUB_PAT=ghp_xxx
# GITHUB_SYNC_REPO=owner/private-config-repo
# GITHUB_SYNC_BRANCH=main
# GITHUB_SYNC_PREFIX=persist
# GITHUB_SYNC_CRON=0 12 * * *
# GITHUB_SYNC_ENABLED=true

# ===== 通知 Notify =====
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/xxx
# NOTIFY_TG_BOT_TOKEN=
# NOTIFY_TG_CHAT_ID=
# NOTIFY_EMAILJS_SERVICE_ID=
# NOTIFY_EMAILJS_TEMPLATE_ID=
# NOTIFY_EMAILJS_PUBLIC_KEY=
# NOTIFY_EMAILJS_PRIVATE_KEY=
