# 复制为 .env 后按需修改

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# Redis（消息队列 & 缓存）
REDIS_URL=redis://localhost:6379/0

# 各服务地址（本地独立调试时使用）
